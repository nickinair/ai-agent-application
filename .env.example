# A3 主应用本地配置模板。部署器（deploy.sh）按 .env.{环境}.local → .env.local → .env.{环境} → .env 取第一个存在的文件。
# 企微、CRM、管理 API 密钥等业务配置放配置中心的 agent-shared / agent-app 命名空间
# （约定见 crm-ai-agent/docs/配置中心约定.md）；这里只放连接类配置和本机才定的开关。
PORT=3002

# 连接配置（只取本地）。REDIS_URL 必须和核心服务（crm-ai-agent）是同一个 Redis 的同一个库；
# 只配 REDIS_URL 即可（会自动拆出主机、端口、密码、库号），也兼容下面单独的 REDIS_HOST 等写法
MYSQL_URL=mysql://agent:agent@localhost:3306/agent_platform
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# 配置中心（运行时内部网关）。部署器默认填 http://a3-gateway:3003；令牌与网关的 GATEWAY_AUTH_TOKEN 一致
# GATEWAY_URL=http://localhost:3003
GATEWAY_AUTH_TOKEN=
# 生产建议 true：读不到配置中心就启动失败
CONFIG_CENTER_REQUIRED=false

# 本机是否持有企微机器人长连接（一个机器人只能有一条长连接：多台机器时只在一台设 true；只取本地）
WECOM_BOT_ENABLED=true

# 企微机器人与回调凭证放配置中心的 wecom 命名空间（./scripts/gateway-manage.sh wecom set，改了自动重连）；
# 本地开发不起网关时也可以写在这里
# WECOM_BOT_ID=your_bot_id
# WECOM_BOT_SECRET=your_bot_secret

# 以下也可以放配置中心（agent-app）
# WECOM_TENANT_ID=1
# CRM_BASE_URL=http://localhost:3001
# CRM_SERVICE_TOKEN=
# TEST_INJECT_ENABLED=false

# 运行时调参（不填用默认值）
QUIET_WINDOW_MS=3000
HARD_TIMEOUT_MS=15000
GROUP_MAX_MESSAGES=5
