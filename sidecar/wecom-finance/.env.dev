# ==============================================================================
# 企业微信会话内容存档 Sidecar · 本地开发与联调配置 (local / dev)
# 驱动模式: mock 模式（开箱即用，自动生成 2048 位 RSA 密钥对与模拟外部群消息）
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 企业微信凭据 (Mock 模式下作为模拟企业标识)
# ------------------------------------------------------------------------------
WECOM_CORPID=ww_dev_mock_corp_001
WECOM_CHATDATA_SECRET=dev_mock_secret_abcdef123456

# ------------------------------------------------------------------------------
# 2. 驱动运行模式
# ------------------------------------------------------------------------------
# 本地联调默认采用 mock 模式（若本地需调试原生 C-SDK，可改为 native 并配置私钥和 C 库）
FINANCE_DRIVER_MODE=mock

# ------------------------------------------------------------------------------
# 3. RSA 私钥配置
# ------------------------------------------------------------------------------
# Mock 模式下留空，系统会在内存中自动生成 2048 位 RSA 密钥对
RSA_PRIVATE_KEY_PATH=
RSA_PRIVATE_KEY_PASSPHRASE=

# ------------------------------------------------------------------------------
# 4. 原生 C-SDK 动态链接库路径 (仅在 native 模式生效)
# ------------------------------------------------------------------------------
WECOM_C_SDK_LIB_PATH=./lib/libWeWorkFinanceSdk_C.so

# ------------------------------------------------------------------------------
# 5. 拉取与游标配置
# ------------------------------------------------------------------------------
POLL_INTERVAL_MS=1000
BATCH_SIZE=20
# 游标存储路径（本地进程运行写至 ./data/seq.dev.cursor；容器化挂载运行映射至宿主机 ./data/local）
CURSOR_STORAGE_PATH=./data/seq.dev.cursor

# ------------------------------------------------------------------------------
# 6. a3 (ai-agent-application) 本地主应用投递端点 Webhook
# ------------------------------------------------------------------------------
# 端点地址说明:
# 1) 本机直接运行 (npm run dev): 使用 http://127.0.0.1:3002/api/admin/wecom/finance-inbound
# 2) 容器化运行 (deploy.sh deploy local): 支持 http://host.docker.internal:3002/api/admin/wecom/finance-inbound
# 3) 同 Docker Compose 网络运行: 使用 http://ai-agent-application:3002/api/admin/wecom/finance-inbound
A3_WEBHOOK_URL=http://host.docker.internal:3002/api/admin/wecom/finance-inbound
A3_WEBHOOK_SECRET=dev_sidecar_token_123
