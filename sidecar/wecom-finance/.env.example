# ==============================================================================
# 企业微信会话内容存档 (WeCom Finance SDK) Sidecar 环境变量配置模板
# 官方文档参考: https://developer.work.weixin.qq.com/document/path/91774
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 企业微信基础认证凭证
# ------------------------------------------------------------------------------
# 企业微信企业唯一 ID (CorpID)
# 获取路径: 企业微信管理后台 -> 我的企业 -> 企业信息 -> 企业ID (以 ww 开头)
WECOM_CORPID=ww1234567890abcdef

# 企业微信“会话内容存档”专属 Secret 密钥
# 获取路径: 企业微信管理后台 -> 管理工具 -> 会话内容存档 -> Secret
# 注意: 该 Secret 仅可用于拉取会话存档，具有最高等级安全敏感度，严禁泄露
WECOM_CHATDATA_SECRET=your_chatdata_secret_here

# ------------------------------------------------------------------------------
# 2. 驱动运行模式控制
# ------------------------------------------------------------------------------
# FINANCE_DRIVER_MODE 可选值:
# - mock   : 本地开发/联调模拟模式。无需企业证书或 C 动态库，系统会自动生成 2048 位开发密钥对并模拟产生外部客户群加解密消息流。
# - native : 生产模式。底层通过 koffi FFI 直接加载 Linux 原生 C 动态链接库 libWeWorkFinanceSdk_C.so 真实拉取数据。
FINANCE_DRIVER_MODE=mock

# ------------------------------------------------------------------------------
# 3. 密码学解密与安全私钥配置 (生产解密必须)
# ------------------------------------------------------------------------------
# 企业在企微后台上传公钥时，对应的企业本地 RSA 私钥文件路径 (PEM 格式)
# 作用: 用于解密企微返回的 encrypt_random_key 得到 AES Key
RSA_PRIVATE_KEY_PATH=./keys/private.pem

# 若生成私钥时设置了口令密码 (Passphrase) 则在此配置，若无密码请保留为空
RSA_PRIVATE_KEY_PASSPHRASE=

# ------------------------------------------------------------------------------
# 4. 原生 C-SDK 动态链接库路径 (仅在 FINANCE_DRIVER_MODE=native 生产模式下生效)
# ------------------------------------------------------------------------------
# 企微官方 Linux 64位动态库 libWeWorkFinanceSdk_C.so 存放路径
# 支持相对路径或绝对路径，容器化部署时默认挂载于 /app/lib/libWeWorkFinanceSdk_C.so
WECOM_C_SDK_LIB_PATH=./lib/libWeWorkFinanceSdk_C.so

# ------------------------------------------------------------------------------
# 5. 游标状态机与拉取控制
# ------------------------------------------------------------------------------
# 长轮询无新消息时的休眠等待间隔 (单位: 毫秒，建议生产环境设置为 500 ~ 2000)
POLL_INTERVAL_MS=1000

# 单批次调用 GetChatData 拉取的最大消息数量 (企微官方上限为 1000，推荐 100 ~ 500)
BATCH_SIZE=100

# 游标自增 Seq 持久化存储文件路径
# 作用: 记录最新处理完毕的消息 seq，系统采用原子重命名写入，保障服务重启后自动从上次断点续拉，避免消息遗漏或重复
CURSOR_STORAGE_PATH=./data/seq.cursor

# ------------------------------------------------------------------------------
# 6. a3 (ai-agent-application) 内部事件通知 Webhook
# ------------------------------------------------------------------------------
# Sidecar 解密出全量客户群消息后，向 a3 主应用投递结构化事件的 HTTP 端点 URL
# a3 默认监听端口 3002，全局前缀为 api/admin
A3_WEBHOOK_URL=http://127.0.0.1:3002/api/admin/wecom/finance-inbound

# 内部通信安全令牌 (Shared Secret)
# Sidecar 发送请求时将在 'x-sidecar-token' 请求头中携带此值；a3 若配置了 WECOM_SIDECAR_TOKEN 则会强校验此令牌
A3_WEBHOOK_SECRET=your_sidecar_internal_token_here
