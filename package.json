{
  "name": "ai-agent-application",
  "version": "0.1.0",
  "private": true,
  "description": "智能体全能平台 · 应用后端：管理 API、规则包/参数/知识库导入脚本、数据库迁移",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node dist/database/migrate.js",
    "admin": "node dist/cli/admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:phase1": "jest test/state-transition.spec.ts test/watchdog.spec.ts test/idle-timeout.spec.ts test/phase1-integration.spec.ts",
    "deploy": "./deploy.sh",
    "deploy:local": "./scripts/deploy.sh deploy local",
    "deploy:test": "./scripts/deploy.sh deploy test",
    "deploy:prod": "./scripts/deploy.sh deploy prod",
    "deploy:status": "./scripts/deploy.sh status local",
    "deploy:stop": "./scripts/deploy.sh stop local",
    "deploy:remote": "./scripts/deploy.sh remote",
    "deploy:remote:status": "./scripts/deploy.sh remote-status",
    "deploy:remote:logs": "./scripts/deploy.sh remote-logs",
    "deploy:remote:stop": "./scripts/deploy.sh remote-stop"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "bcryptjs": "2.4.3",
    "bullmq": "^6.3.14",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.2",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
